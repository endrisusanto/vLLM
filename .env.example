# ==============================================================================
# vLLM Private LLM Turnkey Configuration (Windows 16GB VRAM Optimized)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Selection
# ------------------------------------------------------------------------------
# Nama subdirektori model di dalam folder ./models/
# Contoh: Qwen2.5-7B-Instruct-AWQ, Meta-Llama-3.1-8B-Instruct-AWQ, DeepSeek-R1-Distill-Qwen-7B-AWQ
MODEL_NAME=Qwen2.5-7B-Instruct-AWQ

# Kuantisasi: awq, gptq, fp8, bitsandbytes, atau kosongkan untuk model unquantized/auto
QUANTIZATION=awq

# Tipe data kalkulasi bobot (auto, float16, bfloat16)
DTYPE=auto

# ------------------------------------------------------------------------------
# 2. Network & Security Settings
# ------------------------------------------------------------------------------
# Port yang akan diekspos ke Host Windows & Intranet LAN (default: 8000)
HOST_PORT=8000

# Kunci API untuk proteksi endpoint /v1.
# Rekan kerja harus menyertakan header: Authorization: Bearer <API_KEY>
# Kosongkan atau komentari jika ingin mengizinkan akses tanpa autentikasi.
API_KEY=sk-local-vllm-secret-key

# ------------------------------------------------------------------------------
# 3. GPU VRAM & Concurrency Optimization (Preset: 16GB VRAM)
# ------------------------------------------------------------------------------
# Rasio VRAM yang dialokasikan untuk vLLM (0.90 = ~14.4 GB dari 16GB).
# Menyisakan ~1.6 GB untuk OS Windows, DWM display server, dan overhead CUDA.
GPU_MEMORY_UTILIZATION=0.90

# Panjang konteks maksimum (Context Window).
# 8192 token ideal untuk Qwen2.5 / Llama 3.1 pada GPU 16GB VRAM.
MAX_MODEL_LEN=8192

# Jumlah sekuens/request concurrent yang dapat diproses bersamaan secara paralel.
# Nilai 16 sangat seimbang untuk kebutuhan 5-10 rekan kerja dalam satu tim kantor.
MAX_NUM_SEQS=16

# ------------------------------------------------------------------------------
# 4. Advanced Engine Flags
# ------------------------------------------------------------------------------
# Flag tambahan untuk vLLM entrypoint (misal: --trust-remote-code, --enforce-eager)
EXTRA_ARGS=--trust-remote-code

# Opsional: Hugging Face Token jika mengunduh model gated (Llama-3 resmi)
HF_TOKEN=

